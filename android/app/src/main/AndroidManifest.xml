<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <application android:label="@string/app_name" android:icon="@drawable/smw" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar.Fullscreen"
        android:hardwareAccelerated="true">
        <meta-data android:name="SDL_ENV.SDL_ACCELEROMETER_AS_JOYSTICK" android:value="0" />
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|navigation|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- singleTask: there is only ever one game. Starting it again (icon tapped
             while it runs in the background) brings the running game back instead of
             starting a second SDL session in the same process. -->
        <activity android:name=".GameActivity" android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|navigation|smallestScreenSize|density" />
    </application>
</manifest>
